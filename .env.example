# MerchantOps Connector Environment Configuration
# NOTE: Do NOT commit your real keys or secrets to version control.

# Server Configuration
PORT=3000
NODE_ENV=development

# Operational Mode
# Set to 'true' for local offline testing with synthetic store data
# Set to 'false' to connect to live WooCommerce REST API
DEMO_MODE=true

# WooCommerce REST API Credentials (Required if DEMO_MODE=false)
# Generate under: WooCommerce Admin > Settings > Advanced > REST API
# Permissions required: Read only (mutations strictly blocked by connector)
WOOCOMMERCE_STORE_URL=https://your-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_read_only_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret

# Optional Webhook Secret for HMAC-SHA256 Ingestion Verification
WOOCOMMERCE_WEBHOOK_SECRET=your_webhook_secret_phrase

# Logging level: debug | info | warn | error
LOG_LEVEL=info
